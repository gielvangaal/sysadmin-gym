  {
    "id": "practical-accounts",
    "group": "practical",
    "kind": "native",
    "description": "Create local group gymdesk with GID 23144 and a password-locked local user gymclerk with UID 23144, primary group gymdesk and no home directory.",
    "hint": "Consult useradd(8), groupadd(8) and passwd(1).",
    "setup": "userdel gymclerk 2>/dev/null || true; groupdel gymdesk 2>/dev/null || true",
    "checks": [
      "test \"$(getent group gymdesk | cut -d: -f3)\" = 23144",
      "test \"$(id -u gymclerk)\" = 23144 && test \"$(id -g gymclerk)\" = 23144",
      "getent shadow gymclerk | cut -d: -f2 | grep -Eq '^[!*]'",
      "test ! -d \"$(getent passwd gymclerk | cut -d: -f6)\""
    ],
    "requires": [
      "useradd",
      "groupadd"
    ]
  },
  {
    "id": "practical-membership",
    "group": "practical",
    "kind": "native",
    "description": "The local user gymrunner requires supplementary membership in gymops without losing membership in gymstaff. Preserve its primary group.",
    "hint": "Review usermod and id.",
    "setup": "groupadd -f gymops; groupadd -f gymstaff; id gymrunner >/dev/null 2>&1 || useradd -M gymrunner; usermod -G gymstaff gymrunner",
    "checks": [
      "id -nG gymrunner | tr ' ' '\\n' | grep -qx gymops",
      "id -nG gymrunner | tr ' ' '\\n' | grep -qx gymstaff",
      "test \"$(id -gn gymrunner)\" = gymrunner"
    ],
    "requires": [
      "usermod"
    ]
  },
  {
    "id": "practical-expiry",
    "group": "practical",
    "kind": "native",
    "description": "Set gymtemp to expire on {expiry} and become inactive 7 days after password expiration. Keep the password locked.",
    "hint": "Consult chage(1).",
    "setup": "id gymtemp >/dev/null 2>&1 || useradd -M gymtemp; passwd -l gymtemp; chage -E -1 -I -1 gymtemp",
    "checks": [
      "test \"$(getent shadow gymtemp | cut -d: -f7)\" = 7",
      "test \"$(getent shadow gymtemp | cut -d: -f8)\" = {expiry_days}",
      "getent shadow gymtemp | cut -d: -f2 | grep -Eq '^[!*]'"
    ],
    "requires": [
      "chage"
    ]
  },
  {
    "id": "practical-shared-directory",
    "group": "practical",
    "kind": "native",
    "description": "Create /srv/gym-team owned by root:gymteam. Members must have full access, other users no access, new entries must inherit the group, and members must not delete each other's files.",
    "hint": "Review special directory permission bits and ownership.",
    "setup": "groupadd -f gymteam; mkdir -p /srv/gym-team; chown root:root /srv/gym-team; chmod 755 /srv/gym-team",
    "checks": [
      "test \"$(stat -c '%U:%G:%a' /srv/gym-team)\" = root:gymteam:3770"
    ],
    "requires": [
      "groupadd"
    ]
  },
  {
    "id": "native-cron",
    "group": "practical",
    "kind": "native",
    "description": "Schedule a recurring task for root that writes the current date to /var/log/gym-cron.log every minute. The schedule must survive reboot and the task must run successfully.",
    "hint": "Review crontab(5) and crond.",
    "setup": "rm -f /etc/cron.d/gym-cron /var/log/gym-cron.log; systemctl enable --now crond",
    "checks": [
      "systemctl is-active --quiet crond",
      "systemctl is-enabled --quiet crond",
      "test -s /var/log/gym-cron.log && find /var/log/gym-cron.log -mmin -3 | grep -q .",
      "{ crontab -l -u root 2>/dev/null || true; cat /etc/cron.d/* 2>/dev/null || true; } | grep -E '^[*] [*] [*] [*] [*] .*gym-cron.log'"
    ],
    "requires": [
      "crontab"
    ]
  }
]
